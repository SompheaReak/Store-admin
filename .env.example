# ==============================================================================
# SOMPHEA REAK STORE-ADMIN - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# Never commit the real .env file to version control.
# ==============================================================================

SECRET_KEY=change_this_to_a_secure_random_string
ADMIN_USERNAME=admin
ADMIN_PASS=change_this_to_a_secure_password

# Live PostgreSQL Database URL (points to the same database as storefront)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
